---
import BaseLayout from "../layouts/BaseLayout.astro";
import InteractiveHoverButton from "../components/ui/InteractiveHoverButton.astro";
import TextLabel from "../components/ui/TextLabel.astro";
---

<BaseLayout page="contacto"
    ><main class="section">
        <div class="container">
            <p class="eyebrow">Contacto</p><h1>Cuéntanos tu idea.</h1><p
                class="text-muted"
            >
                Estamos listos para escuchar tu próximo proyecto.
            </p>
            <form class="contact-form" id="contact-form">
                <div class="form-heading">
                    <p class="eyebrow">Escríbenos</p>
                    <h2>Hablemos de tu evento.</h2>
                </div>

                <div class="form-grid">
                    <TextLabel
                        for="nombre"
                        label="Tu nombre"
                        type="text"
                        name="nombre"
                        autocomplete="name"
                        required
                    />
                    <div>
                        <TextLabel
                            for="correo"
                            label="Tu correo"
                            name="correo"
                            autocomplete="email"
                            aria-describedby="correo-ayuda"
                            title="Usa un correo de Gmail, Outlook, Hotmail, Yahoo, iCloud, ProtonMail u otro proveedor reconocido."
                            required
                        />
                        <small id="correo-ayuda" class="field-help">
                            Usa un correo de un proveedor reconocido, por ejemplo Gmail u Outlook.
                        </small>
                    </div>
                    <TextLabel
                        for="telefono"
                        label="Tu número de teléfono"
                        type="tel"
                        name="telefono"
                        autocomplete="tel"
                    />
                    <TextLabel for="evento" label="Tipo de evento" as="select" name="evento" required>
                        <option value="" selected disabled>Selecciona el tipo de evento</option>
                            <option>Celebración privada</option>
                            <option>Boda</option>
                            <option>Evento empresarial</option>
                            <option>Ceremonia o conmemoración</option>
                            <option>Otro</option>
                    </TextLabel>
                    <div class="form-full">
                        <TextLabel for="mensaje" label="Describe tu evento" as="textarea" name="mensaje" rows="5" required />
                    </div>
                </div>

                <InteractiveHoverButton type="submit" text="Enviar consulta" />
                <p class="form-note">Al enviar, se abrirá WhatsApp con tu mensaje preparado.</p>
            </form>
        </div>
    </main></BaseLayout
>

<script src="../scripts/pages/contacto.ts"></script>

<style>
  @import '../styles/pages/contacto.css';
</style>
