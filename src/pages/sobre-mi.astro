---
import BaseLayout from "../layouts/BaseLayout.astro";
import Counts from "../components/counts.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { images } from "../data/image";
import portrait from "../assets/images/YO/file_0000000008ac820ea0a0757b58cffc18.png";

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
    '../assets/images/YO/logros/*.{jpg,jpeg,png,webp,avif}',
    { eager: true },
);

const achievements = images.logros.flatMap((item) => {
    const src = imageFiles[item.src.replace(/^src\//, '../')]?.default;
    return src ? [{ image: src, alt: item.alt }] : [];
});


---

<BaseLayout page="sobreMi">
    <main class="about-page">
        <div class="about-page__inner">
            <div class="about-page__copy">
                <p class="eyebrow">Sobre mí</p>
                <h1>Música que se convierte en recuerdo.</h1>
                <p class="about-page__lead">
                    Soy Moisés, saxofonista y creador de experiencias musicales para celebrar los momentos que merecen quedarse.
                </p>    
                <p class="about-page__body">
                    Desde una entrada elegante hasta una pista llena de energía, acompaño cada evento con un repertorio cuidado y una interpretación cercana.
                </p>
                <a class="about-page__link" href="/contacto">Conversemos sobre tu evento <span aria-hidden="true">↗</span></a>
            </div>

            <figure class="about-page__portrait">
                <Image
                    src={portrait}
                    alt="Moisés tocando el saxofón frente al mar al atardecer"
                    width={1086}
                    height={1448}
                    format="webp"
                    sizes="(max-width: 760px) 92vw, 48vw"
                    loading="eager"
                />
                <figcaption>El saxofón, siempre en el momento justo.</figcaption>
            </figure>

        </div>

        <section class="about-counts" aria-label="Cantidad de eventos de Moisés">
            <h2>Música que se convierte en recuerdo.</h2>
            <Counts />
        </section>

        <section class="about-achievements" aria-labelledby="about-achievements-title">
            <h1 id="about-achievements-title" class="about-achievements__title">Estos son mis logros de mi carrera</h1>
            <p class="about-achievements__lead">
                A lo largo de mi trayectoria, he tenido el privilegio de participar en eventos que han dejado huella. Cada logro es un testimonio de mi compromiso con la excelencia musical y la creación de momentos memorables.
            </p>

            <ol class="about-achievements__list">
                <span class="about-achievements__progress" aria-hidden="true"></span>
                {achievements.map((achievement, index) => (
                    <li class:list={["about-achievements__item", { "about-achievements__item--reverse": index % 2 === 1 }]}>
                        <span class="about-achievements__marker" aria-hidden="true"></span>
                        <article class="about-achievements__card">
                            <Image
                                src={achievement.image}
                                alt={achievement.alt}
                                width={720}
                                height={480}
                                format="webp"
                                sizes="(max-width: 760px) 88vw, 360px"
                                loading="lazy"
                            />
                        </article>
                    </li>
                ))}
            </ol>
        </section>
    </main>
</BaseLayout>

<script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const media = gsap.matchMedia();

    media.add('(prefers-reduced-motion: no-preference)', () => {
        const achievementsList = document.querySelector<HTMLElement>('.about-achievements__list');
        const progress = document.querySelector<HTMLElement>('.about-achievements__progress');
        const achievementItems = gsap.utils.toArray<HTMLElement>('.about-achievements__item');

        if (!achievementsList || !progress || !achievementItems.length) return;

        const trigger = gsap.fromTo(progress,
            { scaleY: 0 },
            {
                scaleY: 1,
                ease: 'none',
                scrollTrigger: {
                    trigger: achievementsList,
                    start: 'top 68%',
                    end: 'bottom 68%',
                    scrub: true,
                },
            },
        );

        // Cada logro tiene su propio trigger para que aparezcan uno a uno,
        // siguiendo el avance natural del scroll y no todos al entrar la lista.
        const itemTriggers = achievementItems.map((item) => {
            const card = item.querySelector<HTMLElement>('.about-achievements__card');
            const marker = item.querySelector<HTMLElement>('.about-achievements__marker');
            const timeline = gsap.timeline({
                scrollTrigger: {
                    trigger: item,
                    start: 'top 82%',
                    toggleActions: 'play none none reverse',
                },
            });

            timeline.fromTo(item,
                { autoAlpha: 0, y: 34 },
                { autoAlpha: 1, y: 0, duration: .7, ease: 'power3.out' },
            );

            if (card) {
                timeline.fromTo(card,
                    { y: 12, scale: .98 },
                    { y: 0, scale: 1, duration: .6, ease: 'power3.out' },
                    '<0.08',
                );
            }

            if (marker) {
                timeline.fromTo(marker,
                    { scale: .5 },
                    { scale: 1, duration: .4, ease: 'back.out(1.6)' },
                    '<',
                );
            }

            return timeline;
        });

        return () => {
            trigger.scrollTrigger?.kill();
            itemTriggers.forEach((timeline) => timeline.scrollTrigger?.kill());
        };
    });
</script>

<style>
    .about-page {
        min-height: 100svh;
        padding: clamp(6rem, 12vh, 10rem) 1.5rem clamp(4rem, 8vh, 7rem);
    }

    .about-page__inner {
        display: grid;
        grid-template-columns: minmax(0, .9fr) minmax(320px, .82fr);
        align-items: center;
        gap: clamp(3rem, 9vw, 9rem);
        width: min(1180px, 100%);
        margin-inline: auto;
    }

    .about-page__copy { max-width: 560px; }
    .about-page h1 {
        max-width: 9ch;
        margin: 1.4rem 0 1.75rem;
        font-size: clamp(3.4rem, 6.8vw, 6.8rem);
        line-height: .92;
    }
    .about-page__lead {
        max-width: 34rem;
        color: var(--color-text);
        font-size: clamp(1.15rem, 1.8vw, 1.4rem);
        line-height: 1.45;
    }
    .about-page__body {
        max-width: 32rem;
        margin-top: 1.25rem;
        color: var(--color-text-muted);
        font-size: 1rem;
        line-height: 1.65;
    }
    .about-page__link {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        min-height: 44px;
        margin-top: 2.25rem;
        border-bottom: 1px solid var(--color-border);
        color: var(--color-text);
        font-weight: 700;
        transition: color .2s ease, border-color .2s ease;
    }
    .about-page__link span { color: var(--color-primary); transition: transform .2s ease; }
    .about-page__link:hover { border-color: var(--color-primary); color: var(--color-primary); }
    .about-page__link:hover span { transform: translate(3px, -3px); }

    .about-page__portrait {
        position: relative;
        width: min(100%, 530px);
        margin: 0 0 0 auto;
        padding-bottom: 2.5rem;
    }
    .about-page__portrait::before {
        position: absolute;
        inset: 1.5rem -1.25rem 0 1.25rem;
        background: var(--color-surface);
        content: '';
    }
    .about-page__portrait :global(img) {
        position: relative;
        width: 100%;
        aspect-ratio: .75;
        object-fit: cover;
        filter: saturate(.86) contrast(1.04);
    }
    .about-page__portrait figcaption {
        position: absolute;
        right: -1rem;
        bottom: 0;
        max-width: 12rem;
        color: var(--color-text);
        font-family: Georgia, serif;
        font-size: .95rem;
        font-style: italic;
        line-height: 1.35;
    }

    .about-timeline {
        width: min(100%, 1040px);
        margin: clamp(7rem, 15vw, 13rem) auto 0;
    }
    .about-timeline__heading { max-width: 34rem; }
    .about-timeline h2 {
        margin-top: 1.25rem;
        font-size: clamp(2.3rem, 4.8vw, 4.8rem);
        line-height: .96;
    }
    .about-timeline__list {
        position: relative;
        display: grid;
        gap: 3.5rem;
        margin: 4rem 0 0;
        padding: 0;
        list-style: none;
    }
    .about-timeline__list::before {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 2px;
        background: var(--color-primary);
        content: '';
        transform: translateX(-50%);
    }
    .about-timeline__progress {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        z-index: 1;
        width: 2px;
        background: var(--color-primary);
        content: '';
        transform: translateX(-50%) scaleY(0);
        transform-origin: top center;
    }
    .about-timeline__item {
        position: relative;
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 150px;
    }
    .about-timeline__marker {
        position: absolute;
        top: 1.25rem;
        left: 50%;
        z-index: 1;
        width: 1.05rem;
        height: 1.05rem;
        border: 4px solid var(--negro);
        border-radius: 50%;
        background: var(--color-primary);
        box-shadow: 0 0 0 1px var(--color-primary);
        transform: translateX(-50%);
    }
    .about-timeline__card {
        width: min(100%, 390px);
        padding: 1.5rem 1.6rem 1.65rem;
        border: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent);
        background: var(--color-card);
    }
    .about-timeline__item:not(.about-timeline__item--reverse) .about-timeline__card { grid-column: 1; justify-self: end; margin-right: 3.25rem; }
    .about-timeline__item--reverse .about-timeline__card { grid-column: 2; justify-self: start; margin-left: 3.25rem; }
    .about-timeline__label { color: var(--color-primary); font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .about-timeline h3 { margin-top: .65rem; font-size: clamp(1.35rem, 2vw, 1.8rem); }
    .about-timeline__card > p:last-child { margin-top: .7rem; color: var(--color-text-muted); font-size: .92rem; line-height: 1.55; }

    .about-achievements {
        width: min(100%, 1040px);
        margin: clamp(8rem, 16vw, 14rem) auto 0;
    }
    .about-counts {
        width: min(1180px, 100%);
        margin: clamp(7rem, 14vw, 12rem) auto 0;
    }
    .about-counts h2 {
        max-width: 12ch;
        margin-bottom: 2.5rem;
        font-size: clamp(2.5rem, 5vw, 5rem);
        line-height: .94;
    }
    .about-counts :global(main) {
        min-height: 0;
        background: transparent;
        overflow: visible;
    }
    .about-counts :global(main > div) {
        max-width: none;
        padding: 0;
    }
    .about-counts :global(main > div > section) {
        gap: 2rem;
    }
    .about-counts :global(footer),
    .about-counts :global(main + footer),
    .about-counts :global(main > div > div) {
        display: none;
    }
    .about-page .about-achievements__title {
        display: block;
        max-width: 14ch;
        margin: 0 0 1.25rem;
        color: var(--color-text);
        font-size: clamp(2.5rem, 5vw, 5rem);
        line-height: .94;
    }
    .about-achievements__lead {
        max-width: 42rem;
        margin: 0;
        color: var(--color-text-muted);
        font-size: clamp(1rem, 1.5vw, 1.2rem);
        line-height: 1.6;
    }
    .about-achievements__heading { max-width: 34rem; }
    .about-achievements h2 { margin-top: 1.25rem; font-size: clamp(2.5rem, 5vw, 5rem); line-height: .94; }
    .about-achievements__list {
        position: relative;
        display: grid;
        gap: 2.5rem;
        margin: 4rem 0 0;
        padding: 0;
        list-style: none;
    }
    .about-achievements__list::before {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 2px;
        background: var(--color-primary);
        content: '';
        transform: translateX(-50%);
    }
    .about-achievements__progress {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        z-index: 1;
        width: 2px;
        background: var(--color-primary);
        transform: translateX(-50%) scaleY(0);
        transform-origin: top center;
    }
    .about-achievements__item { position: relative; display: grid; grid-template-columns: 1fr 1fr; min-height: 150px; }
    .about-achievements__marker {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 1;
        width: 1.05rem;
        height: 1.05rem;
        border: 4px solid var(--negro);
        border-radius: 50%;
        background: var(--color-primary);
        transform: translate(-50%, -50%);
    }
    .about-achievements__card {
        width: min(100%, 390px);
        aspect-ratio: 1;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent);
        background: var(--color-card);
    }
    .about-achievements__card :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        margin: 0;
        object-fit: cover;
    }
    .about-achievements__item:not(.about-achievements__item--reverse) .about-achievements__card { grid-column: 1; justify-self: end; margin-right: 3.25rem; }
    .about-achievements__item--reverse .about-achievements__card { grid-column: 2; justify-self: start; margin-left: 3.25rem; }
    .about-achievements__label { color: var(--color-primary); font-size: .7rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
    .about-achievements h3 { margin-top: .65rem; font-size: clamp(1.35rem, 2vw, 1.8rem); }
    .about-achievements__card > p:last-child { margin-top: .7rem; color: var(--color-text-muted); font-size: .92rem; line-height: 1.55; }

    @media (max-width: 760px) {
        .about-page { padding-inline: 1rem; }
        .about-page__inner { grid-template-columns: 1fr; gap: 3.5rem; }
        .about-page h1 { max-width: 10ch; font-size: clamp(3.3rem, 15vw, 5.2rem); }
        .about-page__portrait { width: calc(100% - 1rem); margin-inline: 0 auto; }
        .about-page__portrait::before { right: -.75rem; left: .75rem; }
        .about-page__portrait figcaption { right: -.5rem; }
        .about-timeline { margin-top: 7rem; }
        .about-timeline__list { gap: 2rem; margin-top: 3rem; padding-left: 1.25rem; }
        .about-timeline__list::before { left: .25rem; transform: none; }
        .about-timeline__progress { left: .25rem; transform: scaleY(0); }
        .about-timeline__item { display: block; min-height: 0; padding-left: 1.25rem; }
        .about-timeline__marker { top: 1.25rem; left: .25rem; }
        .about-timeline__item:not(.about-timeline__item--reverse) .about-timeline__card,
        .about-timeline__item--reverse .about-timeline__card { width: 100%; margin: 0; }
        .about-achievements { margin-top: 7rem; }
        .about-achievements__list { gap: 2rem; margin-top: 3rem; padding-left: 1.25rem; }
        .about-page .about-achievements__title { max-width: 11ch; font-size: clamp(2.8rem, 13vw, 4.5rem); }
        .about-achievements__list::before { left: .25rem; transform: none; }
        .about-achievements__progress { left: .25rem; transform: scaleY(0); }
        .about-achievements__item { display: block; min-height: 0; padding-left: 1.25rem; }
        .about-achievements__marker { top: 1.25rem; left: .25rem; }
        .about-achievements__item:not(.about-achievements__item--reverse) .about-achievements__card,
        .about-achievements__item--reverse .about-achievements__card { width: 100%; margin: 0; }
    }

    @media (prefers-reduced-motion: no-preference) {
        .about-page__copy { animation: about-in .7s cubic-bezier(.22, 1, .36, 1) both; }
        .about-page__portrait { animation: about-in .8s .12s cubic-bezier(.22, 1, .36, 1) both; }
        @keyframes about-in { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
    }

    @media (prefers-reduced-motion: reduce) {
        .about-page__link, .about-page__link span { transition: none; }
    }
</style>
