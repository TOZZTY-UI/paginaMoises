---
import LandingLayout from '../layouts/LandingLayout.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { images } from '../data/image';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>([
  '../assets/images/bodas/*.{jpg,jpeg,png,webp,avif}',
  '../assets/images/funerario/*.{jpg,jpeg,png,webp,avif}',
  '../assets/images/4to_medio/*.{jpg,jpeg,png,webp,avif}',
], { eager: true });
const categoryAlt: Record<string, string> = {
  bodas: 'Fotografía de un matrimonio',
  funerario: 'Fotografía de una ceremonia funeraria',
  '4to_medio': 'Fotografía de una celebración de cuarto medio',
};
const galleryImages = Object.entries(images).flatMap(([category, items]) => items.flatMap((item) => {
  const src = imageFiles[item.src.replace(/^src\//, '../')]?.default;
  return src ? [{ ...item, src, alt: categoryAlt[category] }] : [];
}));
const cards = galleryImages.map((item, index) => {
  const angle = index * 137.5 * Math.PI / 180;
  return {
    ...item,
    index,
    cos: Math.cos(angle),
    sin: Math.sin(angle),
    radiusX: 0.28 + (index % 3) * 0.08,
    radiusY: 0.26 + (index % 2) * 0.09,
    rotation: (index % 2 === 0 ? 1 : -1) * (3 + (index % 5) * 2),
  };
});
---

<LandingLayout page="galeria" showFooter={false}>
<section class="tunnel" data-perspective-tunnel aria-label="Galería inmersiva 3D" tabindex="0">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>

  <div class="intro" data-intro>
    <h1>Galería</h1>
    <p class="description">Desplázate para ver las imágenes.</p>
  </div>

  <div class="scroll-prompt" data-prompt aria-hidden="true">
    <span>Desliza para explorar</span>
    <i></i>
  </div>

  <div class="card-plane" aria-label="Imágenes de la galería">
    {cards.map((card) => (
      <div
        class="tunnel-card"
        data-card
        data-index={card.index}
        data-cos={card.cos}
        data-sin={card.sin}
        data-radius-x={card.radiusX}
        data-radius-y={card.radiusY}
        data-rotation={card.rotation}
        style={`z-index:${card.index + 1}`}
      >
        <div class="card-inner">
          <Image src={card.src} alt={card.alt} width={Math.min(card.src.width, 960)} widths={[320, 640, 960].filter((width) => width <= card.src.width)} sizes="(max-width: 767px) 180px, 270px" format="webp" quality={80} loading="lazy" decoding="async" draggable="false" />
          <div class="card-gradient"><span>{card.name}</span></div>
        </div>
      </div>
    ))}
  </div>
  <div class="gallery-end" data-gallery-end inert aria-hidden="true">
    <h2>¿Quieres aparecer en la galería?</h2>
    <p>Conoce nuestros servicios para tu próximo evento.</p>
    <Button href="/servicios" name="Ver servicios" />
  </div>
</section>
</LandingLayout>

<script src="../scripts/galeria.ts"></script>

<style>
  @import "../styles/galeria.css";
</style>
