---
import LandingLayout from '../layouts/LandingLayout.astro';
import Button from '../components/Button.astro';
import { images } from '../data/image';

const imageFiles = import.meta.glob<{ default: string }>('../assets/images/**/*.{jpg,jpeg,png,webp,avif}', { eager: true, query: '?url' });
const galleryImages = Object.values(images).flat().flatMap((item) => {
  const src = imageFiles[item.src.replace(/^src\//, '../')]?.default;
  return src ? [{ ...item, src }] : [];
});
const cards = galleryImages.map((item, index) => {
  const angle = index * 137.5 * Math.PI / 180;
  return {
    ...item,
    index,
    cos: Math.cos(angle),
    sin: Math.sin(angle),
    radiusX: 0.28 + (index % 3) * 0.08,
    radiusY: 0.26 + (index % 2) * 0.09,
    rotation: (index % 2 === 0 ? 1 : -1) * (3 + (index % 5) * 2),
  };
});
---

<LandingLayout page="galeria" showFooter={false}>
<main>
<section class="tunnel" data-perspective-tunnel aria-label="Galería inmersiva 3D" tabindex="0">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="glow" aria-hidden="true"></div>

  <div class="intro" data-intro>
    <h1>Galería</h1>
    <p class="description">Desplázate para ver las imágenes.</p>
  </div>

  <div class="scroll-prompt" data-prompt aria-hidden="true">
    <span>Desliza para explorar</span>
    <i></i>
  </div>

  <div class="card-plane" aria-label="Imágenes de la galería">
    {cards.map((card) => (
      <div
        class="tunnel-card"
        data-card
        data-index={card.index}
        data-cos={card.cos}
        data-sin={card.sin}
        data-radius-x={card.radiusX}
        data-radius-y={card.radiusY}
        data-rotation={card.rotation}
        style={`z-index:${card.index + 1}`}
      >
        <div class="card-inner">
          <img src={card.src} alt={card.alt} loading="lazy" draggable="false" />
          <div class="card-gradient"><span>{card.name}</span></div>
        </div>
      </div>
    ))}
  </div>
  <div class="gallery-end" data-gallery-end inert aria-hidden="true">
    <h2>¿Quieres aparecer en la galería?</h2>
    <p>Conoce nuestros servicios para tu próximo evento.</p>
    <Button href="/servicios" name="Ver servicios" />
  </div>
</section>
</main>
</LandingLayout>

<script>
  // El código se ejecuta en el navegador; Astro genera el HTML estático.
  const clamp = (n: number, min: number, max: number) => Math.max(min, Math.min(max, n));
  document.querySelectorAll<HTMLElement>('[data-perspective-tunnel]').forEach((root) => {
    const cardNodes = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    // Mezclar las posiciones en cada visita, sin modificar el diccionario original.
    for (let i = cardNodes.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cardNodes[i], cardNodes[j]] = [cardNodes[j], cardNodes[i]];
    }
    cardNodes.forEach((card, index) => {
      const angle = index * 137.5 * Math.PI / 180;
      card.dataset.index = String(index);
      card.dataset.cos = String(Math.cos(angle));
      card.dataset.sin = String(Math.sin(angle));
      card.dataset.radiusX = String(0.28 + (index % 3) * 0.08);
      card.dataset.radiusY = String(0.26 + (index % 2) * 0.09);
      card.dataset.rotation = String((index % 2 === 0 ? 1 : -1) * (3 + (index % 5) * 2));
      card.style.zIndex = String(index + 1);
    });
    const intro = root.querySelector<HTMLElement>('[data-intro]');
    const prompt = root.querySelector<HTMLElement>('[data-prompt]');
    const galleryEnd = root.querySelector<HTMLElement>('[data-gallery-end]');
    const navbar = document.querySelector<HTMLElement>('.navbar-container');
    if (navbar) {
      navbar.classList.add('gallery-nav-hidden');
      navbar.inert = true;
    }
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = root.clientWidth;
    let height = root.clientHeight;
    let mobile = width < 768;
    let targetProgress = 0;
    let progress = 0;
    let targetX = 0;
    let targetY = 0;
    let pointerX = 0;
    let pointerY = 0;
    let raf = 0;
    let lastTouchY: number | null = null;

    const recalc = () => {
      width = root.clientWidth;
      height = root.clientHeight;
      mobile = width < 768;
      root.style.perspective = mobile ? '900px' : '1200px';
    };
    const move = (e: PointerEvent) => {
      if (reducedMotion.matches) return;
      targetX = (e.clientX / window.innerWidth - .5) * 2;
      targetY = (e.clientY / window.innerHeight - .5) * 2;
    };
    const wheel = (e: WheelEvent) => {
      if ((targetProgress >= 1 && e.deltaY > 0) || (targetProgress <= 0 && e.deltaY < 0)) return;
      e.preventDefault();
      targetProgress = clamp(targetProgress + e.deltaY * .0008, 0, 1);
    };
    const touchStart = (e: TouchEvent) => { lastTouchY = e.touches[0]?.clientY ?? null; };
    const touchMove = (e: TouchEvent) => {
      if (lastTouchY === null) return;
      const y = e.touches[0]?.clientY;
      if (y === undefined) return;
      if ((targetProgress >= 1 && y < lastTouchY) || (targetProgress <= 0 && y > lastTouchY)) { lastTouchY = y; return; }
      e.preventDefault();
      targetProgress = clamp(targetProgress + (lastTouchY - y) * .002, 0, 1);
      lastTouchY = y;
    };
    const keydown = (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown' || e.key === 'PageDown') {
        e.preventDefault(); targetProgress = clamp(targetProgress + .08, 0, 1);
      } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
        e.preventDefault(); targetProgress = clamp(targetProgress - .08, 0, 1);
      }
    };
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const map = (v: number, a: number, b: number, c: number, d: number) => lerp(c, d, clamp((v - a) / (b - a), 0, 1));
    const fade = (p: number) => p < .18 ? map(p, 0, .18, 0, 1) : p > .82 ? map(p, .82, .98, 1, 0) : 1;
    function frame() {
      const smoothing = reducedMotion.matches ? 1 : .085;
      progress = lerp(progress, targetProgress, smoothing);
      pointerX = lerp(pointerX, targetX, .075);
      pointerY = lerp(pointerY, targetY, .075);
      const titleScale = progress < .5 ? map(progress, 0, .5, .7, 1) : map(progress, .5, 1, 1, 1.35);
      const introAlpha = progress < .12 ? map(progress, 0, .12, .25, 1) : progress > .85 ? map(progress, .85, 1, 1, 0) : 1;
      if (intro) { intro.style.transform = `scale(${titleScale})`; intro.style.opacity = `${introAlpha}`; }
      if (prompt) prompt.style.opacity = `${map(progress, 0, .12, 1, 0)}`;
      if (navbar) {
        const visible = progress >= .96;
        if (!visible && !navbar.inert && navbar.contains(document.activeElement)) root.focus();
        navbar.classList.toggle('gallery-nav-hidden', !visible);
        navbar.inert = !visible;
      }
      if (galleryEnd) {
        const visible = progress >= .96;
        galleryEnd.classList.toggle('is-visible', visible);
        galleryEnd.inert = !visible;
        galleryEnd.setAttribute('aria-hidden', String(!visible));
      }
      for (const card of cardNodes) {
        const i = Number(card.dataset.index);
        const start = (i / cardNodes.length) * .45;
        const local = clamp((progress - start) / .55, 0, 1);
        const z = lerp(mobile ? -1200 : -1700, mobile ? 350 : 500, local);
        const baseX = Number(card.dataset.cos) * width * Number(card.dataset.radiusX);
        const baseY = Number(card.dataset.sin) * height * Number(card.dataset.radiusY);
        const pan = mobile ? 20 : 45;
        const x = baseX - pointerX * pan;
        const y = baseY - pointerY * pan;
        const w = mobile ? clamp(width * .38, 130, 180) : clamp(width * .18, 180, 270);
        card.style.width = `${w}px`;
        card.style.opacity = `${fade(local)}`;
        card.style.transform = `translate3d(calc(-50% + ${x}px), calc(-50% + ${y}px), ${z}px) rotateZ(${card.dataset.rotation}deg)`;
      }
      raf = requestAnimationFrame(frame);
    }
    const observer = new ResizeObserver(recalc);
    observer.observe(root);
    recalc();
    root.addEventListener('wheel', wheel, { passive: false });
    root.addEventListener('touchstart', touchStart, { passive: true });
    root.addEventListener('touchmove', touchMove, { passive: false });
    root.addEventListener('touchend', () => { lastTouchY = null; });
    root.addEventListener('pointermove', move, { passive: true });
    root.addEventListener('keydown', keydown);
    raf = requestAnimationFrame(frame);
    // Limpieza si Astro reemplaza la página mediante navegación del cliente.
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      observer.disconnect();
      if (navbar) {
        navbar.classList.remove('gallery-nav-hidden');
        navbar.inert = false;
      }
    }, { once: true });
  });
</script>

<style>
  :global(.navbar-container) { transition: opacity .35s ease, visibility .35s ease; }
  :global(.navbar-container.gallery-nav-hidden) { opacity: 0; visibility: hidden; pointer-events: none; }
  main { margin-top: -120px; }
  .tunnel { position: relative; display: flex; justify-content: center; align-items: center; width: 100%; height: 100vh; height: 100dvh; overflow: hidden; isolation: isolate; background: #0a0a0a; color: #fff; user-select: none; transform-style: preserve-3d; }
  .grid-bg,.glow,.ring,.card-plane { position:absolute; pointer-events:none; }
  .grid-bg { inset:0; background-image:radial-gradient(#1e1b4b 1px,transparent 1px); background-size:28px 28px; mask-image:radial-gradient(ellipse 70% 70% at 50% 50%,#000 60%,transparent 100%); opacity:.65; }
  .glow { inset:0; background:radial-gradient(circle at center,rgba(99,102,241,.2),transparent 75%); }
  .intro { z-index:0; text-align:center; padding:0 24px; max-width:680px; pointer-events:none; transform-origin:center; will-change:transform,opacity; }
  .eyebrow { color:#a5b4fc; font:12px/1.6 monospace; text-transform:uppercase; letter-spacing:.4em; margin:0 0 16px; }
  h1 { margin:0; font-size:clamp(3.2rem,10vw,7.5rem); font-weight:800; line-height:.9; letter-spacing:-.065em; background:linear-gradient(#fff 15%,rgba(255,255,255,.38)); background-clip:text; -webkit-background-clip:text; color:transparent; }
  .description { color:#a3a3a3; max-width:38ch; margin:20px auto 0; font-size:clamp(14px,2vw,17px); font-weight:300; }
  .gallery-end { position:absolute; z-index:30; max-width:560px; padding:24px; text-align:center; opacity:0; transform:translateY(12px); transition:opacity .7s ease, transform .7s ease; pointer-events:none; }
  .gallery-end.is-visible { opacity:1; transform:translateY(0); pointer-events:auto; }
  .gallery-end h2 { font-size:clamp(2rem, 5vw, 3.5rem); }
  .gallery-end p { margin:20px 0; }
  @media (prefers-reduced-motion: reduce) { .gallery-end { transition:none; transform:none; } }
  .scroll-prompt { position:absolute; bottom:32px; z-index:20; display:flex; flex-direction:column; align-items:center; gap:8px; font:11px/1.5 monospace; text-transform:uppercase; letter-spacing:.3em; color:#a3a3a3; pointer-events:none; }
  .scroll-prompt i { width:1px; height:24px; background:linear-gradient(#818cf8,transparent); }
  .card-plane { inset:0; transform-style:preserve-3d; }
  .tunnel-card { position:absolute; left:50%; top:50%; aspect-ratio:4/5; opacity:0; transform-style:preserve-3d; will-change:transform,opacity; pointer-events:auto; cursor:pointer; }
  .card-inner { width:100%; height:100%; overflow:hidden; position:relative; background:#171717; border-radius:16px; box-shadow:0 28px 70px rgba(0,0,0,.7); border:1px solid rgba(255,255,255,.16); transition:border-color .4s,box-shadow .4s; }
  .card-inner:hover { border-color:rgba(129,140,248,.75); box-shadow:0 28px 70px rgba(99,102,241,.25); }
  img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .7s ease; }
  .card-inner:hover img { transform:scale(1.1); }
  .card-gradient { position:absolute; inset:0; display:flex; align-items:end; padding:20px; background:linear-gradient(transparent 40%,rgba(0,0,0,.8)); }
  .card-gradient span { color:rgba(255,255,255,.95); text-transform:uppercase; letter-spacing:.18em; font:12px/1.5 monospace; text-shadow:0 1px 8px #000; }
  @media (prefers-color-scheme:light) { .tunnel { background:#fafafa; color:#171717; } .grid-bg { background-image:radial-gradient(#cbd5e1 1px,transparent 1px);opacity:.7; } .glow { background:radial-gradient(circle at center,rgba(99,102,241,.15),transparent 70%); } .ring-two { border-color:rgba(100,116,139,.25); } .eyebrow { color:#4f46e5; } h1 { background:linear-gradient(#0a0a0a,#737373); background-clip:text;-webkit-background-clip:text; } .description { color:#525252; } }
  @media (max-width:600px) { .card-gradient { padding:14px; } .card-gradient span { font-size:10px; } }
</style>
