---
import LandingLayout from '../../layouts/LandingLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter((post) => !post.id.includes('/')).map((post) => ({ params: { slug: post.id } }));
}
const { slug } = Astro.params;
const title = slug?.replace(/-/g, ' ') ?? 'Artículo';
---
<LandingLayout title={`${title} | Blog`}><main class="section"><div class="container"><a href="/blog">← Volver al blog</a><p class="eyebrow" style="margin-top: 4rem">Artículo</p><h1>{title}</h1><p class="text-muted">Contenido editorial de Moisés.</p></div></main></LandingLayout>
