---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services as servicios } from '../../data/services/ts/services';
import Price from '../../components/content/Price.astro';

const planes = servicios.map((servicio) => ({
  slug: servicio.slug,
  name: servicio.title,
  price: servicio.price ? `$ ${servicio.price}` : 'Consultar',
  period: servicio.period ?? 'Por proyecto',
  features: servicio.features,
  subServices: servicio.subServices,
  href: `/servicios/${servicio.slug}`,
  featured: servicio.featured ?? false,
}));
---
<BaseLayout page="servicios">
  <Price
    title="Servicios pensados para avanzar"
    subtitle="Elige la solución que mejor encaja con tu proyecto y descubre todo lo que incluye."
    plans={planes}
  />
</BaseLayout>
