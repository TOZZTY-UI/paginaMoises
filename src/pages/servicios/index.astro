---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services as servicios } from '../../data/services';
import Price from '../../components/price.astro';

const planes = servicios.map((servicio, index) => ({
  name: servicio.title,
  price: `${servicio.price} €`,
  period: 'por proyecto',
  features: servicio.features,
  href: `/servicios/${servicio.slug}`,
  featured: index === 1,
}));
---
<BaseLayout page="servicios">
  <Price
    title="Servicios pensados para avanzar"
    subtitle="Elige la solución que mejor encaja con tu proyecto y descubre todo lo que incluye."
    plans={planes}
  />
</BaseLayout>
