---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ButtonPay from '../../../components/ButtonPay.astro';
import { services, type ServiceSubService } from '../../../data/services/ts/services';

type Props = {
  service: (typeof services)[number];
  subService: ServiceSubService;
};

export function getStaticPaths() {
  return services.flatMap((service) =>
    (service.subServices ?? []).map((subService) => ({
      params: {
        slug: service.slug,
        subSlug: subService.slug,
      },
      props: { service, subService },
    })),
  );
}

const { service, subService } = Astro.props as Props;
const detail = subService.detail ?? {
  sectionEyebrow: 'Una propuesta a tu medida',
  sectionTitle: subService.name,
  sectionDescription: subService.description,
  finalEyebrow: 'Consulta disponibilidad',
  finalTitle: 'Da el siguiente paso.',
  ctaLabel: 'Consultar disponibilidad',
  imageAlt: `Presentación de ${subService.name}`,
};
const paymentHref = subService.paymentHref && subService.paymentHref !== '.'
  ? subService.paymentHref
  : '/contacto';
---

<BaseLayout
  title={`${subService.name} | ${service.title}`}
  description={subService.description}
  image={subService.image}
>
  <article class="service-detail">
    <a class="service-detail__back" href={`/servicios/${service.slug}`}>
      ← Volver a {service.title}
    </a>

    <div class="service-detail__hero">
      <div class="service-detail__copy">
        <p class="service-detail__eyebrow">{service.title}</p>
        <h1>{subService.name}</h1>
        <p class="service-detail__lead">{subService.description}</p>
        <ButtonPay href={paymentHref} name="Pagar ↗" />
      </div>

      <figure class="service-detail__image service-detail__image--hero">
        <img src={subService.image} alt={`Ejemplo de ${subService.name}`} width="1400" height="1000" />
      </figure>
    </div>

    <section class="service-detail__body" aria-labelledby="service-details-title">
      <div>
        <p class="service-detail__eyebrow">{detail.sectionEyebrow}</p>
        <h2 id="service-details-title">{detail.sectionTitle}</h2>
      </div>

      <div class="service-detail__content">
        <p>
          {detail.sectionDescription}
        </p>
        <ul class="service-detail__highlights">
          {subService.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
      </div>
    </section>

    <figure class="service-detail__image service-detail__image--wide">
      <img src={subService.image} alt={detail.imageAlt} width="1400" height="700" loading="lazy" />
    </figure>

    <section class="service-detail__final-cta" aria-label="Reservar servicio">
      <p class="service-detail__eyebrow">{detail.finalEyebrow}</p>
      <h2>{detail.finalTitle}</h2>
      <ButtonPay href={paymentHref} name="Pagar / reservar servicio ↗" />
    </section>
  </article>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: subService.name,
  description: subService.description,
  serviceType: 'Música de saxofón en vivo para eventos',
  provider: { '@id': 'https://saxeventos.cl/#business' },
  areaServed: { '@type': 'Country', name: 'Chile' },
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://saxeventos.cl').href,
})} />

<style>
  @import '../../../styles/components/service-detail.css';
</style>
