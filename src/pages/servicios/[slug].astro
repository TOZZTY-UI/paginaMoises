---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services } from "../../data/services/ts/services";
import InteractiveHoverButton from '../../components/ui/InteractiveHoverButton.astro';

type Props = {
  title: string;
  description: string;
  service: (typeof services)[number];
};

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: {
      title: service.title,
      description: service.description,
      service,
    },
  }));
}

const { title, description, service } = Astro.props as Props;
const getOriginalPrice = (price: number | string | undefined) => {
  if (price === undefined || price === null) return null;
  const numericPrice = Number(String(price).replace(/[^\d]/g, ''));
  if (!Number.isFinite(numericPrice) || numericPrice <= 0) return null;
  return Math.round((numericPrice / 0.75) / 10) * 10;
};
const detail = service.detail ?? {
  intro: service.description,
  objectiveEyebrow: 'Sobre este servicio',
  objectiveTitle: service.title,
  objective: service.description,
  idealForTitle: 'Ideal para',
  deliverablesEyebrow: 'Qué incluye',
  deliverablesTitle: 'Una propuesta a tu medida.',
  processEyebrow: 'Cómo trabajaremos',
  processTitle: 'Coordinamos cada detalle.',
  deliverables: service.features,
  process: [],
  idealFor: [],
  finalEyebrow: 'Consulta disponibilidad',
  finalTitle: 'Da el siguiente paso.',
  ctaLabel: 'Consultar disponibilidad',
  ctaHref: '/contacto',
};
---

<BaseLayout title={`${title} | SaxEventos`} description={description}
>
  <article class="service-detail">
    <a class="service-detail__back" href="/servicios">← Todos los servicios</a>

    <div class="service-detail__hero">
      <div class="service-detail__copy">
        <p class="service-detail__eyebrow">{service.title}</p>
        <h1>{service.title}</h1>
      </div>

      {service.subServices?.length ? (
        <div class="service-detail__hero-options">
          <p class="service-detail__eyebrow">Opciones disponibles</p>
          <h2 id="service-offers-title">Elige el servicio ideal para tu evento.</h2>
          <p>Conoce cada alternativa y reserva la propuesta que mejor se adapta a tu celebración.</p>
        </div>
      ) : null}
    </div>

    {service.subServices?.length ? (
      <section class="service-detail__offers" aria-labelledby="service-offers-title">
        <div class="service-detail__offers-grid">
          {service.subServices.map((subService) => (
            <article class="service-detail__offer">
              <div class="service-detail__offer-copy">
                <h3>{subService.name}</h3>
                <p>{subService.description}</p>
                <ul class="service-detail__offer-highlights">
                  {subService.highlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}
                </ul>
              </div>

              <footer class="service-detail__offer-footer">
                <div>
                  {subService.price && (subService.originalPrice || getOriginalPrice(subService.price)) ? (
                    <span class="service-detail__offer-original-price">
                      $ {subService.originalPrice ?? getOriginalPrice(subService.price)?.toLocaleString('es-CL')}
                    </span>
                  ) : null}
                  <div class="service-detail__offer-current-price">
                    <strong>{subService.price ? `$ ${subService.price}` : subService.priceLabel ?? 'Consultar'}</strong>
                    {subService.price && (subService.originalPrice || getOriginalPrice(subService.price)) ? <span class="service-detail__offer-discount">-25%</span> : null}
                  </div>
                  <span>Por evento</span>
                </div>
                <a class="service-detail__offer-link" href={`/servicios/${service.slug}/${subService.slug}`}>
                  Ver detalles <span aria-hidden="true">↗</span>
                </a>
              </footer>
            </article>
          ))}
        </div>
      </section>
    ) : null}

    <section class="service-detail__body" aria-labelledby="service-objective-title">
      <div>
        <p class="service-detail__eyebrow">{detail.objectiveEyebrow}</p>
        <h2 id="service-objective-title">{detail.objectiveTitle}</h2>
      </div>
      <div class="service-detail__content">
        <p>{detail.objective}</p>
        {detail.idealFor.length > 0 && (
          <>
            <h3>{detail.idealForTitle}</h3>
            <ul class="service-detail__highlights">
              {detail.idealFor.map((item) => <li>{item}</li>)}
            </ul>
          </>
        )}
      </div>
    </section>

    <div class="service-detail__columns">
      <section aria-labelledby="service-deliverables-title">
        <p class="service-detail__eyebrow">{detail.deliverablesEyebrow}</p>
        <h2 id="service-deliverables-title">{detail.deliverablesTitle}</h2>
        <ul class="service-detail__highlights">
          {detail.deliverables.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section aria-labelledby="service-process-title">
        <p class="service-detail__eyebrow">{detail.processEyebrow}</p>
        <h2 id="service-process-title">{detail.processTitle}</h2>
        <ol class="service-detail__process">
          {detail.process.map((step) => <li>{step}</li>)}
        </ol>
      </section>
    </div>

    <section class="service-detail__final-cta" aria-label="Solicitar información">
      <p class="service-detail__eyebrow">{detail.finalEyebrow}</p>
      <h2>{detail.finalTitle}</h2>
      <InteractiveHoverButton href={detail.ctaHref} text={detail.ctaLabel} className="service-detail__cta" />
    </section>
  </article>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.description,
  serviceType: 'Música de saxofón en vivo para eventos',
  provider: { '@id': 'https://saxeventos.cl/#business' },
  areaServed: { '@type': 'Country', name: 'Chile' },
  url: new URL(Astro.url.pathname, Astro.site ?? 'https://saxeventos.cl').href,
  ...(service.price ? { offers: {
    '@type': 'Offer',
    price: service.price,
    priceCurrency: 'CLP',
    availability: 'https://schema.org/InStock',
  } } : {}),
})} />

<style>
  @import '../../styles/pages/servicios/service-detail.css';
</style>
