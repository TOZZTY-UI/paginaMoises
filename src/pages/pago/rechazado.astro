---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InteractiveHoverButton from '../../components/ui/InteractiveHoverButton.astro';
---

<BaseLayout
  title="Pago rechazado | SaxEventos"
  description="No fue posible completar tu pago."
  noIndex
>
  <main class="payment-status payment-status--failed">
    <div class="payment-status__card">
      <p class="eyebrow">SaxEventos · Pago no completado</p>
      <h1>Tu pago fue rechazado.</h1>
      <p>
        No se realizó ningún cargo confirmado. Puedes intentar nuevamente o
        contactarnos para revisar otra alternativa de pago.
      </p>
      <div class="payment-status__actions">
        <InteractiveHoverButton href="/contacto" text="Intentar nuevamente" />
        <a class="payment-status__back" href="/">Volver al inicio</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .payment-status {
    display: grid;
    min-height: 70vh;
    place-items: center;
    padding: clamp(4rem, 10vw, 8rem) 1.25rem;
    background: var(--negro);
    color: var(--marfil);
  }

  .payment-status__card {
    width: min(100%, 40rem);
    padding: clamp(2rem, 6vw, 4rem);
    border: 1px solid color-mix(in srgb, var(--burdeos) 75%, transparent);
    background: var(--color-card);
    text-align: center;
  }

  .payment-status h1 {
    margin: 1rem 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 400;
  }

  .payment-status p:not(.eyebrow) {
    color: var(--gris);
    line-height: 1.7;
  }

  .payment-status__actions {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .payment-status__back {
    color: var(--dorado);
  }
</style>
