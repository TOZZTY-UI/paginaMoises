---
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../sections/Hero.astro';
import QuienSoy from '../sections/QuienSoy.astro';
import Intro from '../sections/Intro.astro';
import Empresas from '../sections/Empresas.astro';
import MuestraServicios from '../sections/MuestraServicios.astro';
import ContactCTA from '../sections/ContactCTA.astro';
import Footer from '../components/layout/Footer.astro';



import '../styles/pages/landing.css';
import TestimonialsStack from '../components/content/TestimonialsStack.astro';
import { testimonials } from '../data/testimonials';

---

<LandingLayout page="home">
  <main>
    <Hero />
    <QuienSoy />
    <Intro />
    <Empresas />
    <MuestraServicios />
    <TestimonialsStack testimonials={testimonials} title="Historias que se escuchan y se recuerdan" subtitle="La experiencia de nuestros clientes" variant="dark" />
    <ContactCTA />
 </main>
  <Footer />
</LandingLayout>
