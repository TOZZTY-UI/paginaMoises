---
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../sections/Hero.astro';
import QuienSoy from '../sections/QuienSoy.astro';
import Intro from '../sections/Intro.astro';
import Empresas from '../sections/Empresas.astro';
import MuestraServicios from '../sections/MuestraServicios.astro';
import ContactCTA from '../sections/ContactCTA.astro';
import Footer from '../components/Footer.astro';



import '../styles/landing.css';
import TestimonialsStack from '../components/TestimonialsStack.astro';
import { testimonials } from '../data/testimonials';

---

<LandingLayout page="home">
  <main>
    <Hero />
    <QuienSoy />
    <Intro />
    <Empresas />
    <MuestraServicios />
    <TestimonialsStack testimonials={testimonials} title="Historias que se escuchan y se recuerdan" subtitle="La experiencia de nuestros clientes" variant="dark" />
    <ContactCTA />
 </main>
  <Footer />
</LandingLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const initSectionTransitions = () => {
    const main = document.querySelector('main');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sections = gsap.utils.toArray<HTMLElement>('main > section:not(.hero)');

    if (!main || main.dataset.sectionTransitionsReady || reducedMotion.matches || !sections.length) return;
    main.dataset.sectionTransitionsReady = 'true';

    const context = gsap.context(() => {
      gsap.set(sections, { autoAlpha: 0, y: 34 });

      ScrollTrigger.batch(sections, {
        start: 'top 86%',
        interval: 0.08,
        batchMax: 3,
        onEnter: (batch) => gsap.to(batch, {
          autoAlpha: 1,
          y: 0,
          duration: .8,
          ease: 'power3.out',
          overwrite: 'auto',
          stagger: .08,
        }),
        onLeaveBack: (batch) => gsap.to(batch, {
          autoAlpha: 0,
          y: 34,
          duration: .45,
          ease: 'power2.in',
          overwrite: 'auto',
        }),
      });
    });

    document.addEventListener('astro:before-swap', () => context.revert(), { once: true });
  };

  initSectionTransitions();
  document.addEventListener('astro:page-load', initSectionTransitions);
</script>
