---
import LandingLayout from '../layouts/LandingLayout.astro';
import Hero from '../sections/Hero.astro';
import Intro from '../sections/Intro.astro';
import MuestraServicios from '../sections/MuestraServicios.astro';
import ContactCTA from '../sections/ContactCTA.astro';
import Footer from '../components/Footer.astro';


import '../styles/landing.css';
import TestimonialsStack from '../components/TestimonialsStack.astro';
import { testimonials } from '../data/testimonials';

---

<LandingLayout page="home">
  <main>
    <Hero />
    <Intro />
    <MuestraServicios />
    <TestimonialsStack testimonials={testimonials} title="Historias que se escuchan y se recuerdan" subtitle="La experiencia de nuestros clientes" variant="dark" />
    <ContactCTA />
 </main>
  <Footer />
</LandingLayout>
