---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqs = [
    {
        question: "¿Para qué tipo de eventos puedo contratar SaxEventos?",
        answer: "Realizamos presentaciones para matrimonios, ceremonias, cócteles, cenas, cumpleaños, eventos corporativos y homenajes funerarios.",
    },
    {
        question: "¿Cuánto dura la presentación?",
        answer: "La duración depende del servicio elegido. Algunas experiencias incluyen una hora de saxofón en vivo y otras acompañan distintos momentos del evento.",
    },
    {
        question: "¿Puedo elegir las canciones?",
        answer: "Sí. Coordinamos previamente el repertorio y puedes proponer canciones especiales para la ceremonia, el cumpleaños o la celebración.",
    },
    {
        question: "¿Con cuánto tiempo debo reservar?",
        answer: "Recomendamos consultar y reservar con anticipación, especialmente para matrimonios y fechas de alta demanda. La reserva depende de la disponibilidad de la fecha.",
    },
    {
        question: "¿El saxofonista puede interactuar con los invitados?",
        answer: "Sí. En las experiencias de cóctel, cena y cumpleaños la presentación puede ser cercana, dinámica e interactiva, recorriendo distintos espacios del evento.",
    },
    {
        question: "¿Cómo solicito disponibilidad y cotización?",
        answer: "Escríbenos indicando la fecha, la ciudad, el tipo de evento y el servicio que te interesa. Te responderemos con la disponibilidad y los detalles para reservar.",
    },
];
---

<BaseLayout page="faq">
    <main class="section">
        <div class="container">
            <p class="eyebrow">FAQ</p>
            <h1>Preguntas frecuentes.</h1>

            <div class="faq-list">
                {faqs.map((faq) => (
                    <details class="card faq-item">
                        <summary>{faq.question}</summary>
                        <div class="faq-answer">
                            <p class="text-muted">{faq.answer}</p>
                        </div>
                    </details>
                ))}
            </div>
        </div>
    </main>
    <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: {
                '@type': 'Answer',
                text: faq.answer,
            }
        }))
    })} />
</BaseLayout>

<script src="../scripts/pages/preguntas-frecuentes.ts"></script>

<style>
  @import '../styles/pages/preguntas-frecuentes.css';
</style>
