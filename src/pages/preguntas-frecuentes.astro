---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout page="faq"
    >
    <main class="section">
        <div class="container">
            <p class="eyebrow">FAQ</p><h1>Preguntas frecuentes.</h1><details
                class="card"
                style="padding: 1.5rem; margin-top: 2rem"
            >
                <summary>¿Cómo comenzamos?</summary><p class="text-muted">
                    Escríbenos y coordinaremos una primera conversación.
                </p>
            </details>
        </div>
    </main>
    <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [{
            '@type': 'Question',
            name: '¿Cómo comenzamos?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Escríbenos y coordinaremos una primera conversación.'
            }
        }]
    })} />
</BaseLayout>
