---
import BaseLayout from "../layouts/BaseLayout.astro";
import InteractiveHoverButton from "../components/ui/InteractiveHoverButton.astro";
import heroImage from "../assets/images/YO/file_000000001a70820ea1065f0bc7e02e3e.png";
import ContactCtaAstroComponent from "../sections/ContactCTA.astro";
import faqGroups from "../data/faqs.json";

const faqs = faqGroups.flatMap((group) => group.faqs);
---

<BaseLayout page="faq">
    <section class="faq-page section" aria-labelledby="faq-title">
        <div class="container">
            <div class="faq-hero">
                <div class="faq-hero__copy">
                    <h1 id="faq-title">Preguntas sobre saxofón en vivo.</h1>
                    <p class="faq-hero__lead">
                        Resuelve tus dudas sobre repertorio, duración, disponibilidad y contratación para bodas,
                        celebraciones y eventos en todo Chile.
                    </p>
                    <div class="faq-hero__actions">
                        <InteractiveHoverButton href="/contacto" text="Consultar disponibilidad" />
                        <a class="faq-text-link" href="/servicios">Explorar servicios <span aria-hidden="true">↗</span></a>
                    </div>
                </div>
                <aside class="faq-hero__note" aria-label="Resumen del servicio">
                    <figure class="faq-hero__image">
                        <img src={heroImage.src} alt="Moisés tocando el saxofón durante una celebración" width={heroImage.width} height={heroImage.height} loading="eager" fetchpriority="high" />
                    </figure>
                    <p>La música se coordina contigo para que cada momento tenga su propia atmósfera.</p>
                    <a href="/repertorio">Conoce el repertorio <span aria-hidden="true">↗</span></a>
                </aside>
            </div>

            <div class="faq-content">
                <div class="faq-content__intro">
                    <h2>Elige con claridad.</h2>
                </div>

                <div class="faq-groups">
                    {faqGroups.map((group) => (
                        <section class="faq-group" aria-labelledby={`faq-group-${group.title}`}>
                            <div class="faq-group__heading">
                                <h2 id={`faq-group-${group.title}`}>{group.title}</h2>
                                <p>{group.description}</p>
                            </div>
                            <div class="faq-list">
                                {group.faqs.map((faq, index) => {
                                    const answerId = `faq-answer-${faqGroups.indexOf(group)}-${index}`;
                                    return (
                                        <details class="card faq-item" open={faq.question.includes("tipo de eventos")}>
                                            <summary aria-controls={answerId}>{faq.question}</summary>
                                            <div class="faq-answer" id={answerId}>
                                                <p>{faq.answer}</p>
                                            </div>
                                        </details>
                                    );
                                })}
                            </div>
                        </section>
                    ))}
                </div>
            </div>

            <section class="faq-process" aria-labelledby="faq-process-title">
                <div>
                    <h2 id="faq-process-title">Así reservamos.</h2>
                </div>
                <ol class="faq-process__steps">
                    <li><strong>Cuéntanos tu fecha</strong><span>Comparte ciudad, tipo de evento y horario aproximado.</span></li>
                    <li><strong>Revisamos la propuesta</strong><span>Confirmamos disponibilidad y la alternativa que mejor encaja.</span></li>
                    <li><strong>Coordinamos los detalles</strong><span>Definimos repertorio, momentos y el ambiente de tu celebración.</span></li>
                </ol>
            </section>

            <ContactCtaAstroComponent />
        </div>
    </section>
    <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': 'https://saxeventos.cl/preguntas-frecuentes/#faq',
        url: 'https://saxeventos.cl/preguntas-frecuentes/',
        name: 'Preguntas frecuentes sobre saxofón en vivo | SaxEventos',
        mainEntity: faqs.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: {
                '@type': 'Answer',
                text: faq.answer,
            }
        }))
    })} />
</BaseLayout>

<script src="../scripts/pages/preguntas-frecuentes.ts"></script>

<style>
  @import '../styles/pages/preguntas-frecuentes.css';
</style>
