---
import heroImage from '../assets/images/YO/file_000000001a70820ea1065f0bc7e02e3e.png';
---

<section class="hero" aria-labelledby="hero-title" style={`--hero-background: url('${heroImage.src}')`}>
  <div class="hero__content">
    <a class="hero__brand" href="/" aria-label="Saxeventos, inicio">
      <img src="/icons/logo.webp" alt="" width="44" height="44" />
      <span><strong>Saxeventos</strong><small>Música para momentos que importan</small></span>
    </a>

    <div class="hero__message">
      <p class="hero__eyebrow">Saxofón en vivo · Santiago y Chile</p>
      <h1 id="hero-title">La música que<br /><em>hace memoria.</em></h1>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__intro">Saxofón en vivo para bodas, celebraciones y eventos donde cada instante merece sonar distinto.</p>
      <a class="hero__cta" href="/contacto">Hablemos de tu fecha <span aria-hidden="true">↗</span></a>
    </div>

    <div class="hero__details" aria-label="Información de contacto">
      <a href="https://saxeventos.cl">saxeventos.cl</a>
      <a href="tel:+56949251898">+56 9 4925 1898</a>
      <span>Santiago, Chile</span>
    </div>

    <a class="hero__scroll-cue" href="#hero-visual" aria-label="Deslizar hacia la siguiente sección">
      <span>Desliza para descubrir</span>
      <i aria-hidden="true"></i>
    </a>
  </div>

  <div class="hero__visual" id="hero-visual">
    <img src={heroImage.src} alt="Moisés tocando el saxofón en una celebración" width={heroImage.width} height={heroImage.height} />
    <div class="hero__visual-caption" aria-hidden="true">Música que se siente<br />antes de escucharse.</div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const media = gsap.matchMedia();

  media.add('(max-width: 760px) and (prefers-reduced-motion: no-preference)', () => {
    const cue = document.querySelector<HTMLElement>('.hero__scroll-cue');
    const heroContent = document.querySelector<HTMLElement>('.hero__content');

    if (!cue || !heroContent) return;

    const hideCue = () => gsap.to(cue, { autoAlpha: 0, y: 10, duration: 0.22, ease: 'power2.out', overwrite: true });
    const showCue = () => gsap.to(cue, { autoAlpha: 1, y: 0, duration: 0.3, ease: 'power2.out', overwrite: true });

    const trigger = ScrollTrigger.create({
      trigger: heroContent,
      start: 'top top',
      end: 'bottom top',
      onUpdate: (self) => {
        if (self.direction === 1 && self.progress > 0.03) hideCue();
        if (self.direction === -1 && self.progress < 0.45) showCue();
      },
    });

    return () => trigger.kill();
  });
</script>

<style>
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .9fr); height: 100svh; min-height: 0; overflow: hidden; background: var(--negro); color: var(--marfil); }
  .hero__content { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: space-between; width: min(100%, 760px); min-height: 0; height: 100%; margin-left: auto; padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1.25rem, 6vw, 5.5rem); }
  .hero__brand { display: inline-flex; align-items: center; gap: .8rem; width: fit-content; animation: hero-content-in .6s .15s cubic-bezier(.4, 0, .2, 1) both; }
  .hero__brand img { width: 2.75rem; height: 2.75rem; border-radius: .75rem; }
  .hero__brand span { display: grid; gap: .1rem; }
  .hero__brand strong { color: var(--marfil); font-family: var(--font-display); font-size: 1.05rem; letter-spacing: -.04em; }
  .hero__brand small { color: var(--gris); font-size: .62rem; letter-spacing: .08em; }
  .hero__message { max-width: 38rem; margin-block: auto; padding-block: clamp(4rem, 8vw, 8rem); }
  .hero__eyebrow { margin-bottom: 1.5rem; color: var(--dorado); font-size: .7rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; animation: hero-content-in .65s .25s cubic-bezier(.4, 0, .2, 1) both; }
  .hero h1 { max-width: 9ch; color: var(--marfil); font-size: clamp(3.8rem, 7.5vw, 7.6rem); line-height: .91; letter-spacing: -.085em; animation: hero-content-in .7s .32s cubic-bezier(.4, 0, .2, 1) both; }
  .hero h1 em { color: var(--dorado); font-family: var(--font-accent); font-weight: 400; letter-spacing: 0; }
  .hero__rule { display: block; width: 5rem; height: 3px; margin-block: 2rem 1.6rem; background: var(--dorado); animation: hero-rule-in .55s .43s cubic-bezier(.4, 0, .2, 1) both; }
  .hero__intro { max-width: 31rem; color: var(--gris); font-size: 1.05rem; line-height: 1.6; animation: hero-content-in .6s .48s cubic-bezier(.4, 0, .2, 1) both; }
  .hero__cta { display: inline-flex; align-items: center; gap: .65rem; margin-top: 2rem; padding-bottom: .5rem; border-bottom: 1px solid var(--dorado); color: var(--marfil); font-weight: 700; animation: hero-content-in .6s .56s cubic-bezier(.4, 0, .2, 1) both; }
  .hero__cta span { color: var(--dorado); transition: transform .2s ease; }
  .hero__cta:hover span { transform: translate(3px, -3px); }
  .hero__details { display: flex; flex-wrap: wrap; gap: clamp(1rem, 4vw, 3.5rem); color: var(--gris); font-size: .72rem; animation: hero-content-in .6s .64s cubic-bezier(.4, 0, .2, 1) both; }
  .hero__details a:hover { color: var(--dorado); }
  .hero__scroll-cue { display: none; }
  .hero__visual { position: absolute; inset: 0 0 0 55%; z-index: 2; overflow: hidden; clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%); background: var(--burdeos); animation: hero-image-reveal .85s cubic-bezier(.4, 0, .2, 1) both; }
  .hero__visual::after { position: absolute; inset: 0; content: ''; background: linear-gradient(110deg, color-mix(in srgb, var(--negro) 30%, transparent), transparent 45%), linear-gradient(0deg, color-mix(in srgb, var(--negro) 36%, transparent), transparent 45%); pointer-events: none; }
  .hero__visual img { width: 100%; height: 100%; object-fit: cover; object-position: 61% 25%; filter: saturate(.82) contrast(1.08); animation: hero-image-settle 1.1s .05s cubic-bezier(.4, 0, .2, 1) both; }
  .hero__visual-caption { position: absolute; right: clamp(1.25rem, 4vw, 3rem); bottom: clamp(2rem, 6vw, 5rem); z-index: 1; color: var(--marfil); font-family: Georgia, serif; font-size: clamp(1rem, 1.5vw, 1.25rem); font-style: italic; line-height: 1.25; text-align: right; animation: hero-content-in .65s .7s cubic-bezier(.4, 0, .2, 1) both; }
  @keyframes hero-image-reveal { from { opacity: 0; transform: translateX(8%); clip-path: polygon(38% 0, 100% 0, 100% 100%, 18% 100%); } to { opacity: 1; transform: translateX(0); clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%); } }
  @keyframes hero-image-settle { from { transform: scale(1.08) translateX(2%); } to { transform: scale(1) translateX(0); } }
  @keyframes hero-content-in { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes hero-rule-in { from { opacity: 0; transform: scaleX(0); transform-origin: left; } to { opacity: 1; transform: scaleX(1); transform-origin: left; } }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; min-height: auto; }
    .hero::before { position: absolute; inset: 0; z-index: 0; content: ''; background-image: linear-gradient(color-mix(in srgb, var(--negro) 88%, transparent), color-mix(in srgb, var(--negro) 88%, transparent)), var(--hero-background); background-position: 61% 25%; background-size: cover; opacity: .5; pointer-events: none; }
    .hero__content { min-height: 100svh; padding-bottom: 3.5rem; }
    .hero__message { padding-block: 3rem 2rem; }
    .hero h1 { font-size: clamp(3.35rem, 14vw, 5.2rem); }
    .hero__intro { font-size: .98rem; }
    .hero__cta { margin-top: 1.5rem; }
    .hero__details { justify-content: center; margin-bottom: 2rem; font-size: .66rem; text-align: center; }
    .hero__scroll-cue { position: absolute; left: 50%; bottom: .85rem; z-index: 3; display: inline-flex; flex-direction: column; align-items: center; gap: .35rem; color: var(--marfil); font-size: .66rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; transform: translateX(-50%); }
    .hero__scroll-cue i { position: relative; display: block; width: 1.25rem; height: 1.25rem; border: 1px solid var(--dorado); border-radius: 50%; }
    .hero__scroll-cue i::after { position: absolute; top: .25rem; left: .43rem; width: .32rem; height: .32rem; border-right: 2px solid var(--dorado); border-bottom: 2px solid var(--dorado); content: ''; transform: rotate(45deg); }
    .hero__scroll-cue:hover { color: var(--dorado); }
    .hero__scroll-cue i { animation: scroll-cue-bounce 1.6s ease-in-out infinite; }
    .hero__visual { display: none; }
  }
  @keyframes hero-image-reveal-mobile { from { opacity: 0; transform: translateY(7%); clip-path: polygon(0 18%, 100% 0, 100% 100%, 0 100%); } to { opacity: 1; transform: translateY(0); clip-path: polygon(0 8%, 100% 0, 100% 100%, 0 100%); } }
  @keyframes scroll-cue-bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(5px); } }
  @media (prefers-reduced-motion: reduce) {
    .hero__brand, .hero__eyebrow, .hero h1, .hero__rule, .hero__intro, .hero__cta, .hero__details, .hero__visual, .hero__visual img, .hero__visual-caption, .hero__scroll-cue i { animation: none; opacity: 1; transform: none; clip-path: none; }
    .hero__cta span { transition: none; }
  }
</style>
