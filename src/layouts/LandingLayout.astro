---
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import '../styles/components/page-transitions.css';
import { seo, type SEOPage } from '../data/seo';

interface Props {
  page: SEOPage;
  title?: string;
  description?: string;
  image?: string;
}

const { page, title, description, image } = Astro.props;
const seoData = seo[page];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <SEO title={title ?? seoData.title} description={description ?? seoData.description} image={image} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<script src="../scripts/block-reveal.ts"></script>
