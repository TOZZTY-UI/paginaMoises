---
// Reemplaza estos valores por tus cifras reales.
const stats = [
    { value: 500, suffix: '+', label: 'Canciones interpretadas' },
    { value: 150, suffix: '+', label: 'Eventos realizados' },
    { value: 10000, suffix: '+', label: 'Personas felices' },
];
---

<section class="counts-section" aria-labelledby="counts-title">
    <div class="counts-section__heading">
        <p class="counts-section__eyebrow">La experiencia en números</p>
        <h2 id="counts-title">Una trayectoria hecha de momentos.</h2>
    </div>

    <div class="counts" data-counts aria-label="Resumen de experiencia profesional">
        {stats.map((stat) => (
            <article class="counts__item">
                <p class="counts__number" data-count-target={stat.value}>
                    <span data-count-value>0</span><span class="counts__suffix">{stat.suffix}</span>
                </p>
                <p class="counts__label">{stat.label}</p>
            </article>
        ))}
    </div>
</section>

<script>
    const startCounters = () => {
        document.querySelectorAll<HTMLElement>('[data-counts]').forEach((container) => {
            if (container.dataset.countsStarted) return;
            container.dataset.countsStarted = 'true';

            const animate = () => {
                container.querySelectorAll<HTMLElement>('[data-count-value]').forEach((valueElement) => {
                    const target = Number(valueElement.closest('[data-count-target]')?.getAttribute('data-count-target') ?? 0);
                    const start = performance.now();
                    const duration = 1600;

                    const update = (now: number) => {
                        const progress = Math.min((now - start) / duration, 1);
                        const eased = 1 - Math.pow(1 - progress, 3);
                        valueElement.textContent = Math.floor(target * eased).toLocaleString('es-CL');

                        if (progress < 1) requestAnimationFrame(update);
                    };

                    requestAnimationFrame(update);
                });
            };

            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                container.querySelectorAll<HTMLElement>('[data-count-value]').forEach((valueElement) => {
                    const target = Number(valueElement.closest('[data-count-target]')?.getAttribute('data-count-target') ?? 0);
                    valueElement.textContent = target.toLocaleString('es-CL');
                });
                return;
            }

            if (!('IntersectionObserver' in window)) {
                animate();
                return;
            }

            const observer = new IntersectionObserver((entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                    animate();
                    observer.disconnect();
                }
            }, { threshold: 0.2 });

            observer.observe(container);
        });
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startCounters, { once: true });
    } else {
        startCounters();
    }
</script>

<style>
    .counts-section {
        display: grid;
        gap: clamp(2rem, 5vw, 4rem);
        width: 100vw;
        margin-left: calc(50% - 50vw);
        padding: clamp(3rem, 7vw, 6rem) max(1.5rem, calc((100vw - 1180px) / 2));
        border-block: 1px solid var(--color-border);
        background: var(--color-surface);
    }

    .counts-section__heading,
    .counts { width: min(100%, 1180px); margin-inline: auto; }
    .counts-section__heading { max-width: 1180px; }

    .counts-section__eyebrow {
        color: var(--color-primary);
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .counts-section h2 {
        max-width: 10ch;
        margin-top: .75rem;
        color: var(--color-text);
        font-size: clamp(2rem, 4vw, 4rem);
        line-height: .95;
    }

    .counts {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1rem, 5vw, 5rem);
    }

    .counts__item {
        min-height: 0;
        padding: 0;
    }

    .counts__number {
        color: var(--color-primary);
        font-size: clamp(2.7rem, 5vw, 5.5rem);
        font-weight: 800;
        letter-spacing: -.06em;
        line-height: .9;
        font-variant-numeric: tabular-nums;
    }

    .counts__suffix { margin-left: .12em; }

    .counts__label {
        max-width: 10rem;
        margin-top: .75rem;
        color: var(--color-text);
        font-size: .85rem;
        line-height: 1.3;
    }

    @media (max-width: 760px) {
        .counts-section { padding-block: 3rem; }
        .counts { grid-template-columns: 1fr; }
        .counts__item { min-height: 0; padding: 1.15rem 1.25rem; }
        .counts__number { font-size: clamp(3rem, 15vw, 5rem); }
    }

    @media (prefers-reduced-motion: reduce) {
        .counts__number { transition: none; }
    }
</style>
