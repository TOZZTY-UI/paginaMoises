---
import { sidebarColors, sidebarLinks } from '../data/sidebar';
import { Image } from 'astro:assets';
import firma from '../assets/images/Firma.png';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const icons: Record<string, string> = {
  home: 'M3 10 12 3l9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
  user: 'M20 21a8 8 0 0 0-16 0 M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8',
  music: 'M9 18V5l10-2v13 M9 18a3 3 0 1 1-3-3 3 3 0 0 1 3 3 M19 16a3 3 0 1 1-3-3 3 3 0 0 1 3 3',
  image: 'M4 4h16v16H4z M8 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3 M4 17l5-5 3 3 3-3 5 5',
  list: 'M9 6h12 M9 12h12 M9 18h12 M4 6h.01 M4 12h.01 M4 18h.01',
  mail: 'M3 5h18v14H3z M3 6l9 7 9-7',
  message: 'M21 11.5a8.5 8.5 0 0 1-12.8 7.3L3 21l1.8-5A8.5 8.5 0 1 1 21 11.5Z M8 11h8 M8 14h5',
};
---

<div class="sidebar-shell" data-sidebar style={`--sidebar-bg:${sidebarColors.background};--sidebar-accent:${sidebarColors.accent}`}>
  <aside class="sidebar" id="animated-sidebar" aria-label="Menú principal" aria-hidden="true" inert>
    <div class="sidebar-heading"><Image src={firma} alt="Firma de Moisés Larenas, saxofonista" width={240} format="webp" loading="lazy" /></div>
    <button class="sidebar-close" type="button" aria-label="Cerrar menú">
      <i class="fi fi-rr-angle-small-right" aria-hidden="true"></i>
    </button>
    <nav aria-label="Navegación principal">
      {sidebarLinks.map((link, index) => {
        const active = link.href !== '' && (link.href === currentPath || (link.href !== '/' && currentPath.startsWith(`${link.href}/`)));
        return link.href ? (
          <a href={link.href} class:list={['sidebar-link', { active }]} aria-current={active ? 'page' : undefined} style={`--index:${index}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[link.icon]} /></svg>
            <span>{link.label}</span>
          </a>
        ) : (
          <span class="sidebar-link unavailable" style={`--index:${index}`} aria-disabled="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[link.icon]} /></svg>
            <span>{link.label}</span><small>Próximamente</small>
          </span>
        );
      })}
    </nav>
  </aside>
  <div class="page-frame" data-page-frame>
    <button class="sidebar-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="animated-sidebar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <slot />
    <button class="page-dismiss" type="button" aria-label="Cerrar menú" tabindex="-1" inert></button>
  </div>
</div>

<style>
  @import "../styles/animated-sidebar.css";
</style>

<script src="../scripts/animated-sidebar.ts"></script>
