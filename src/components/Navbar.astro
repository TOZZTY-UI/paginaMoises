
---
const links = [
  { label: "Inicio", href: "/" },
  { label: "Contacto", href: "/contacto" },
  { label: "FAQ", href: "/faq" },
  { label: "Galería", href: "/galeria" },
    { label: "Servicios", href: "/servicios" },
    { label: "Sobre Mi", href: "/sobre-mi" },

];

const currentPath = Astro.url.pathname;
---

<header class="navbar-container">
  <nav class="navbar" aria-label="Navegación principal">

      <!-- Enlaces principales -->
    <div class="desktop-links">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "nav-link",
            { active: link.href === currentPath || (link.href !== "/" && currentPath.startsWith(`${link.href}/`)) }
          ]}
          aria-current={
            link.href === currentPath || (link.href !== "/" && currentPath.startsWith(`${link.href}/`)) ? "page" : undefined
          }
        >
          {link.label}
        </a>
      ))}
    </div>

    <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">☰</button>
  </nav>

  <!-- Menú móvil -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>
</header>

<style>
  .navbar-container {
    position: relative;
    z-index: 100;
    width: min(1100px, calc(100% - 32px));
    margin: 24px auto;
    font-family: Inter, Arial, sans-serif;
  }

  .navbar {
    min-height: 72px;
    padding: 12px 28px;
    background: #0d0d11;
    border: 1px solid #29292e;
    border-radius: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    box-shadow: 0 12px 35px #00000020;
  }

  .menu-button,
  .user-circle {
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: #00ef93;
    color: #06120d;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .menu-button {
    display: none;
    cursor: pointer;
    transition: transform .25s, background .25s;
  }

  .menu-button:hover {
    background: #3bffb2;
    transform: scale(1.08);
  }

  .menu-button svg,
  .user-circle svg {
    width: 21px;
    height: 21px;
  }

  .desktop-links {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 30px);
  }

  .nav-link {
    text-decoration: none;
    color: #d7d7d9;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .4px;
    padding: 12px 18px;
    border-radius: 50px;
    transition: .25s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #00ef93;
  }

  .nav-link.active {
    color: #06120d;
    background: #00ef93;
  }

  .login {
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .login:hover .user-circle {
    background: #3bffb2;
  }

  .mobile-menu {
    margin-top: 10px;
    background: #0d0d11;
    border: 1px solid #29292e;
    border-radius: 22px;
    padding: 12px;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 14px 18px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
  }

  .mobile-menu a:hover {
    background: #00ef93;
    color: #06120d;
  }

  @media (min-width: 769px) {
    .mobile-menu:not([hidden]) {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 10px 18px;
      min-height: 62px;
    }

    .desktop-links {
      display: none;
    }

    .menu-button {
      display: grid;
    }

    .login span:last-child {
      display: none;
    }
  }
</style>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(
    ".menu-button"
  );
  const mobileMenu = document.querySelector<HTMLElement>(
    "#mobile-menu"
  );

  menuButton?.addEventListener("click", () => {
    if (!mobileMenu) return;

    mobileMenu.hidden = !mobileMenu.hidden;

    menuButton.setAttribute(
      "aria-expanded",
      String(!mobileMenu.hidden)
    );
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.hidden = true;
      menuButton?.setAttribute("aria-expanded", "false");
    });
  });
</script>
