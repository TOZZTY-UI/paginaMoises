---
import { footerLinks as navigation } from "../data/navigation";
const currentPath = Astro.url.pathname;
---

<header class="navbar-container">
  <nav class="navbar" aria-label="Navegación principal">

      <!-- Enlaces principales -->
    <div class="desktop-links">
      {navigation.map((link) => (
        <a
          href={link.href}
          class:list={[
            "nav-link",
            { active: link.href === currentPath || (link.href !== "/" && currentPath.startsWith(`${link.href}/`)) }
          ]}
          aria-current={
            link.href === currentPath || (link.href !== "/" && currentPath.startsWith(`${link.href}/`)) ? "page" : undefined
          }
        >
          {link.label}
        </a>
      ))}
    </div>

    <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M12 4v16M4 12h16" /></svg>
    </button>
  </nav>

  <!-- Accesos del menú compacto; inspirados en Uiverse.io por risabbir. -->
  <div class="mobile-menu" id="mobile-menu" inert aria-hidden="true">
    {navigation.map((link, index) => (
      <a href={link.href} style={`--item: ${index}`} aria-current={link.href === currentPath || currentPath.startsWith(`${link.href}/`) ? 'page' : undefined}>
        <span class="menu-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {index === 0 && <><circle cx="12" cy="8" r="4" /><path d="M5 21a7 7 0 0 1 14 0" /></>}
            {index === 1 && <><circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.5 2.5 0 1 1 4 2c-1 .7-1.5 1.2-1.5 2.5M12 17h.01" /></>}
            {index === 2 && <><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8" cy="9" r="1.5" /><path d="m3 17 5-5 3 3 3-3 7 6" /></>}
            {index === 3 && <><path d="M9 18V5l10-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="16" cy="16" r="3" /></>}
            {index === 4 && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></>}
          </svg>
        </span>
        <span class="menu-label">{link.label}</span>
      </a>
    ))}
  </div>
</header>

<style>
  @import "../styles/components/navbar.css";
</style>

<script src="../scripts/navbar.ts"></script>
