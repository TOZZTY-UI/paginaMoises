---
import { navigation } from "../data/navigation";
const currentPath = Astro.url.pathname;
---

<header class="navbar-container">
  <nav class="navbar" aria-label="Navegación principal">

      <!-- Enlaces principales -->
    <div class="desktop-links">
      {navigation.map((link) => (
        <a
          href={link.href}
          class:list={[
            "nav-link",
            { active: link.href === currentPath || (link.href !== "/" && currentPath.startsWith(`${link.href}/`)) }
          ]}
          aria-current={
            link.href === currentPath || (link.href !== "/" && currentPath.startsWith(`${link.href}/`)) ? "page" : undefined
          }
        >
          {link.label}
        </a>
      ))}
    </div>

    <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">☰</button>
  </nav>

  <!-- Menú móvil -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    {navigation.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </div>
</header>

<style>
  .navbar-container {
    position: sticky;
    top: max(16px, env(safe-area-inset-top));
    z-index: 100;
    width: min(1100px, calc(100% - 32px));
    margin: 24px auto;
    font-family: Inter, Arial, sans-serif;
  }

  .navbar {
    box-sizing: border-box;
    width: 100%;
    height: 72px;
    margin-inline: auto;
    min-height: 72px;
    padding: 12px 28px;
    background: #0d0d11;
    border: 1px solid #29292e;
    border-radius: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    box-shadow: 0 12px 35px #00000020;
    transition: width .4s cubic-bezier(.4, 0, .2, 1), padding .4s cubic-bezier(.4, 0, .2, 1);
  }

  .navbar-container.is-compact .navbar {
    width: 72px;
    padding-inline: 0;
  }

  .navbar-container.is-compact .desktop-links {
    display: none;
  }

  .navbar-container.is-compact .menu-button {
    display: grid;
  }

  .menu-button,
  .user-circle {
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: #00ef93;
    color: #06120d;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .menu-button {
    display: none;
    cursor: pointer;
    transition: transform .25s, background .25s;
  }

  .menu-button:hover {
    background: #3bffb2;
    transform: scale(1.08);
  }

  .menu-button svg,
  .user-circle svg {
    width: 21px;
    height: 21px;
  }

  .desktop-links {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 30px);
  }

  .nav-link {
    text-decoration: none;
    color: #d7d7d9;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .4px;
    padding: 12px 18px;
    border-radius: 50px;
    transition: .25s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #00ef93;
  }

  .nav-link.active {
    color: #06120d;
    background: #00ef93;
  }

  .login {
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .login:hover .user-circle {
    background: #3bffb2;
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: min(320px, 100%);
    box-sizing: border-box;
    margin-top: 10px;
    max-height: calc(100dvh - 110px - env(safe-area-inset-top));
    overflow-y: auto;
    background: #0d0d11;
    border: 1px solid #29292e;
    border-radius: 22px;
    padding: 12px;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 14px 18px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
  }

  .mobile-menu a:hover {
    background: #00ef93;
    color: #06120d;
  }

  @media (min-width: 769px) {
    .navbar-container:not(.is-compact) .mobile-menu:not([hidden]) {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 10px 18px;
      min-height: 62px;
    }

    .desktop-links {
      display: none;
    }

    .menu-button {
      display: grid;
    }

    .login span:last-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar, .menu-button {
      transition: none;
    }
  }
</style>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(
    ".menu-button"
  );
  const mobileMenu = document.querySelector<HTMLElement>(
    "#mobile-menu"
  );
  const navbar = document.querySelector<HTMLElement>(".navbar-container");
  const desktopLinks = navbar?.querySelector<HTMLElement>(".desktop-links");

  const closeMenu = () => {
    if (mobileMenu) mobileMenu.hidden = true;
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Abrir menú");
  };

  const updateNavbar = () => {
    if (!navbar) return;
    const compact = window.scrollY > 160;
    const moveFocus = compact && !navbar.classList.contains("is-compact") && desktopLinks?.contains(document.activeElement);
    if (!compact && navbar.classList.contains("is-compact")) closeMenu();
    navbar.classList.toggle("is-compact", compact);
    if (moveFocus) menuButton?.focus();
  };
  window.addEventListener("scroll", updateNavbar, { passive: true });
  updateNavbar();

  menuButton?.addEventListener("click", () => {
    if (!mobileMenu) return;

    mobileMenu.hidden = !mobileMenu.hidden;

    menuButton.setAttribute(
      "aria-expanded",
      String(!mobileMenu.hidden)
    );
    menuButton.setAttribute("aria-label", mobileMenu.hidden ? "Abrir menú" : "Cerrar menú");
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      closeMenu();
    });
  });
</script>
