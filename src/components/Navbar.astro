---
import { navigation } from "../data/navigation";
const currentPath = Astro.url.pathname;
---

<header class="navbar-container">
  <nav class="navbar" aria-label="Navegación principal">

      <!-- Enlaces principales -->
    <div class="desktop-links">
      {navigation.map((link) => (
        <a
          href={link.href}
          class:list={[
            "nav-link",
            { active: link.href === currentPath || (link.href !== "/" && currentPath.startsWith(`${link.href}/`)) }
          ]}
          aria-current={
            link.href === currentPath || (link.href !== "/" && currentPath.startsWith(`${link.href}/`)) ? "page" : undefined
          }
        >
          {link.label}
        </a>
      ))}
    </div>

    <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M12 4v16M4 12h16" /></svg>
    </button>
  </nav>

  <!-- Accesos del menú compacto; inspirados en Uiverse.io por risabbir. -->
  <div class="mobile-menu" id="mobile-menu" inert aria-hidden="true">
    {navigation.map((link, index) => (
      <a href={link.href} style={`--item: ${index}`} aria-current={link.href === currentPath || currentPath.startsWith(`${link.href}/`) ? 'page' : undefined}>
        <span class="menu-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {index === 0 && <><circle cx="12" cy="8" r="4" /><path d="M5 21a7 7 0 0 1 14 0" /></>}
            {index === 1 && <><circle cx="12" cy="12" r="9" /><path d="M9.5 9a2.5 2.5 0 1 1 4 2c-1 .7-1.5 1.2-1.5 2.5M12 17h.01" /></>}
            {index === 2 && <><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8" cy="9" r="1.5" /><path d="m3 17 5-5 3 3 3-3 7 6" /></>}
            {index === 3 && <><path d="M9 18V5l10-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="16" cy="16" r="3" /></>}
            {index === 4 && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></>}
          </svg>
        </span>
        <span class="menu-label">{link.label}</span>
      </a>
    ))}
  </div>
</header>

<style>
  .navbar-container {
    position: sticky;
    top: max(16px, env(safe-area-inset-top));
    z-index: 100;
    width: min(1100px, calc(100% - 32px));
    margin: 24px auto;
    font-family: Inter, Arial, sans-serif;
  }

  .navbar {
    box-sizing: border-box;
    width: 100%;
    height: 72px;
    margin-inline: auto;
    min-height: 72px;
    padding: 12px 28px;
    background: #0d0d11;
    border: 1px solid #29292e;
    border-radius: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    box-shadow: 0 12px 35px #00000020;
    transition: width .4s cubic-bezier(.4, 0, .2, 1), padding .4s cubic-bezier(.4, 0, .2, 1), background .4s ease, border-color .4s ease, box-shadow .4s ease;
  }

  .navbar-container.is-compact .navbar {
    width: 72px;
    padding-inline: 0;
  }

  .navbar-container.is-compact .desktop-links {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(.9);
  }

  .navbar-container.is-compact .menu-button {
    display: grid;
  }

  .menu-button,
  .user-circle {
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
    background: #00ef93;
    color: #06120d;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .menu-button {
    display: none;
    cursor: pointer;
    transition: transform .25s, background .25s;
  }

  .menu-button:hover {
    background: #3bffb2;
    transform: scale(1.08);
  }

  .menu-button svg,
  .user-circle svg {
    width: 21px;
    height: 21px;
  }

  .desktop-links {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 30px);
    transition: opacity .25s ease, transform .4s cubic-bezier(.4, 0, .2, 1), visibility .25s;
  }

  .nav-link {
    text-decoration: none;
    color: #d7d7d9;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .4px;
    padding: 12px 18px;
    border-radius: 50px;
    transition: .25s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #00ef93;
  }

  .nav-link.active {
    color: #06120d;
    background: #00ef93;
  }

  .login {
    display: flex;
    align-items: center;
    gap: 10px;
    color: white;
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }

  .login:hover .user-circle {
    background: #3bffb2;
  }

  .navbar-container.is-compact .navbar {
    background: transparent;
    border-color: transparent;
    box-shadow: none;
  }

  .menu-button {
    position: relative;
    z-index: 2;
    width: 64px;
    height: 64px;
    background: #3b82f6;
    color: white;
    box-shadow: 0 8px 20px #0003;
  }
  .menu-button:hover { background: #2563eb; }
  .menu-button svg { width: 32px; height: 32px; transition: transform .3s ease; }
  .menu-button[aria-expanded="true"] svg { transform: rotate(45deg); }
  .menu-button:focus-visible, .mobile-menu a:focus-visible { outline: 3px solid #2563eb; outline-offset: 4px; }

  .mobile-menu {
    position: absolute;
    top: 36px;
    left: 50%;
    z-index: 1;
    pointer-events: none;
  }
  .mobile-menu a {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    width: 68px;
    color: #202632;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(.6);
    transition: transform .45s cubic-bezier(.68,-.55,.27,1.55), opacity .25s ease;
  }
  .mobile-menu a:nth-child(1) { --offset: -3; }
  .mobile-menu a:nth-child(2) { --offset: -2; }
  .mobile-menu a:nth-child(3) { --offset: -1; }
  .mobile-menu a:nth-child(4) { --offset: 1; }
  .mobile-menu a:nth-child(5) { --offset: 2; }
  .mobile-menu.is-open { pointer-events: auto; }
  .mobile-menu.is-open a {
    opacity: 1;
    transform: translate(calc(-50% + var(--offset) * 78px), -50%) scale(1);
    transition-delay: calc(var(--item) * 40ms);
  }
  .menu-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: white;
    color: #667085;
    box-shadow: 0 6px 18px #0003;
    transition: transform .2s ease, color .2s ease;
  }
  .menu-icon svg { width: 21px; height: 21px; }
  .mobile-menu a:hover .menu-icon, .mobile-menu a[aria-current="page"] .menu-icon { color: #2563eb; transform: scale(1.08); }
  .menu-label { padding: 2px 4px; border-radius: 4px; background: white; }

  @media (min-width: 769px) {
    .navbar { position: relative; }
    .desktop-links { position: absolute; }
    .menu-button {
      display: grid;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: scale(.7);
      transition: opacity .25s ease, transform .4s cubic-bezier(.4, 0, .2, 1), visibility .25s, background .25s;
    }
    .navbar-container.is-compact .menu-button {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: scale(1);
    }
    .navbar-container.is-compact .menu-button:hover { transform: scale(1.08); }
    .navbar-container:not(.is-compact) .mobile-menu:not([hidden]) {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .navbar-container {
      width: 100%;
      margin: 0;
      top: 0;
    }

    .navbar, .navbar-container.is-compact .navbar {
      position: relative;
      z-index: 2;
      width: 100%;
      height: auto;
      min-height: 0;
      padding: max(16px, env(safe-area-inset-top)) 20px 0;
      justify-content: flex-start;
      background: transparent;
      border: 0;
      box-shadow: none;
    }

    .desktop-links {
      display: none;
    }

    .menu-button {
      display: grid;
    }

    .mobile-menu {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: 12px;
      overflow-y: auto;
      padding: calc(max(16px, env(safe-area-inset-top)) + 90px) 24px max(24px, env(safe-area-inset-bottom));
      background: #0d0d11;
      transform: translateX(-100%);
      visibility: hidden;
      transition: transform .4s cubic-bezier(.4, 0, .2, 1), visibility .4s;
    }
    .mobile-menu.is-open {
      transform: translateX(0);
      visibility: visible;
    }
    .mobile-menu a {
      position: static;
      width: 100%;
      flex-direction: row;
      gap: 16px;
      color: white;
      font-size: 20px;
      text-align: left;
      opacity: 1;
      transform: none;
      transition: none;
    }
    .mobile-menu.is-open a {
      transform: none;
      transition-delay: 0s;
    }
    .menu-icon { flex-shrink: 0; box-shadow: none; }
    .menu-label { padding: 0; background: transparent; }

    .login span:last-child {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar, .desktop-links, .menu-button, .menu-button svg, .mobile-menu, .mobile-menu a, .menu-icon {
      transition: none;
    }
  }
</style>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>(
    ".menu-button"
  );
  const mobileMenu = document.querySelector<HTMLElement>(
    "#mobile-menu"
  );
  const navbar = document.querySelector<HTMLElement>(".navbar-container");
  const desktopLinks = navbar?.querySelector<HTMLElement>(".desktop-links");
  const mobileViewport = window.matchMedia("(max-width: 768px)");
  let previousOverflow: string | undefined;

  const closeMenu = () => {
    if (mobileMenu) {
      mobileMenu.classList.remove("is-open");
      mobileMenu.inert = true;
      mobileMenu.setAttribute("aria-hidden", "true");
    }
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Abrir menú");
    if (previousOverflow !== undefined) {
      document.body.style.overflow = previousOverflow;
      previousOverflow = undefined;
    }
  };

  const updateNavbar = () => {
    if (!navbar) return;
    const compact = window.scrollY > 160;
    const moveFocus = compact && !navbar.classList.contains("is-compact") && desktopLinks?.contains(document.activeElement);
    const restoreFocus = !compact && navbar.classList.contains("is-compact") && navbar.contains(document.activeElement) && !desktopLinks?.contains(document.activeElement);
    if (!compact && navbar.classList.contains("is-compact") && !mobileViewport.matches) {
      closeMenu();
    }
    navbar.classList.toggle("is-compact", compact);
    if (moveFocus) menuButton?.focus();
    if (restoreFocus && window.matchMedia("(min-width: 769px)").matches) desktopLinks?.querySelector<HTMLAnchorElement>("a")?.focus();
  };
  window.addEventListener("scroll", updateNavbar, { passive: true });
  updateNavbar();

  menuButton?.addEventListener("click", () => {
    if (!mobileMenu) return;

    const open = !mobileMenu.classList.contains("is-open");
    mobileMenu.classList.toggle("is-open", open);
    mobileMenu.inert = !open;
    mobileMenu.setAttribute("aria-hidden", String(!open));
    menuButton.setAttribute("aria-expanded", String(open));
    menuButton.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    if (open && mobileViewport.matches) {
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
    } else if (!open) {
      closeMenu();
    }
  });

  mobileViewport.addEventListener("change", closeMenu);

  document.addEventListener("click", (event) => {
    if (event.target instanceof Node && !navbar?.contains(event.target)) closeMenu();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menuButton?.getAttribute("aria-expanded") === "true") {
      closeMenu();
      menuButton.focus();
    }
    if (event.key === "Tab" && mobileViewport.matches && menuButton?.getAttribute("aria-expanded") === "true") {
      const links = mobileMenu?.querySelectorAll<HTMLAnchorElement>("a");
      const last = links?.[links.length - 1];
      if (event.shiftKey && document.activeElement === menuButton && last) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        menuButton.focus();
      }
    }
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      closeMenu();
    });
  });
</script>
