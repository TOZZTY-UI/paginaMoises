---
interface Props {
  href?: string;
  text?: string;
  className?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: unknown;
}

const { href, text = 'Button', className, type = 'button', ...attributes } = Astro.props as Props;
const classes = ['interactive-hover-button', className].filter(Boolean).join(' ');
---

{href ? (
  <a {...attributes} href={href} class={classes}>
    <span class="interactive-hover-button__label">{text}</span>
    <span class="interactive-hover-button__hover-label" aria-hidden="true">
      {text}
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
    <span class="interactive-hover-button__fill" aria-hidden="true"></span>
  </a>
) : (
  <button {...attributes} type={type} class={classes}>
    <span class="interactive-hover-button__label">{text}</span>
    <span class="interactive-hover-button__hover-label" aria-hidden="true">
      {text}
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
    <span class="interactive-hover-button__fill" aria-hidden="true"></span>
  </button>
)}
