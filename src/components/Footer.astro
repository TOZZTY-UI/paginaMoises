---
import { socialLinks } from "../data/socialLinks";
import { navigation, footerLinks } from "../data/navigation";
import { Image } from "astro:assets";
import firma from "../assets/images/Firma.png";
interface Link {
  label: string;
  href?: string;
}
interface Column {
  title: string;
  links: Link[];
}
interface Action extends Link {
  variant?: "solid" | "outline";
}
interface Props {
  wordmark?: string;
  brand?: string;
  blurb?: string;
  columns?: Column[];
  actions?: Action[];
  copyright?: string;
  backToTop?: boolean;
}

const {
  wordmark = "SAXEVENTOS",
  brand = "saxeventos",
  blurb = "Música para acompañar tus momentos especiales.",
  columns = [
    {
      title: "Explora",
      links: footerLinks,
    },
    {
      title: "Información",
      links: [
        { label: "Preguntas frecuentes", href: navigation.find((link) => link.id === 'faq')?.href },
        ...navigation.filter((link) => link.id === 'privacidad' || link.id === 'terminos'),
      ],
    },
    {
      title: "Contacto",
      links: [
        ...navigation.filter((link) => link.id === 'contacto'),
      ],
    },
  ],
  copyright = "©" + new Date().getFullYear() + " saxeventos.",
  backToTop = true,
} = Astro.props;

const doodles = [
  "𝅜",
  "𝅝",
  "𝅗𝅥",
  "𝅘𝅥",
  "𝅘𝅥𝅮",
  "𝅘𝅥𝅯",
  "𝅘𝅥𝅰",
  "𝅘𝅥𝅱",
  "𝅘𝅥𝅱",
  "𝅘𝅥𝅲",
  "♭",
  "♮",
  "♯",
  "𝄞",
  "𝄢",
];
---

<footer class="dcf" data-footer>
  <div class="dcf-top">
    <div class="dcf-brand">
      <Image src={firma} alt={`Firma de ${brand}`} width={240} format="webp" loading="lazy" />
    </div>
    {blurb && <p class="dcf-blurb">{blurb}</p>}
    {
      columns.length > 0 && (
        <nav class="dcf-cols" aria-label="Footer">
          {columns.map((column) => (
            <div>
              <h3>{column.title}</h3>
              <ul>
                {column.links.map((link) => (
                  <li>
                    {link.href ? (
                      <a href={link.href}>{link.label}</a>
                    ) : (
                      <span>{link.label}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )
    }
  </div>

  <div class="dcf-world">
    <div class="dcf-stage">
      <div class="dcf-doodles" aria-hidden="true">
        {
          doodles.map((doodle, i) => (
            <span style={`--x:${5 + i * 12}%;--delay:${i * -0.8}s`}>
              {doodle}
            </span>
          ))
        }
      </div>
      <h2 class="dcf-wordmark" aria-label={wordmark}>
        {
          Array.from(wordmark.toUpperCase()).map((letter, i) => (
            <span aria-hidden="true" style={`--i:${i}`}>
              {letter === " " ? "\u00a0" : letter}
            </span>
          ))
        }
      </h2>
      <div class="dcf-bubble" role="status" aria-live="polite" hidden></div>
    </div>
  </div>
  <br />
  <div class="dcf-bar">
    <p>{copyright}</p>
    {
      socialLinks.length > 0 && (
        <ul aria-label="Social media">
          {socialLinks.map((link) => (
            <li>
              <a href={link.url} aria-label={link.name} title={link.name}>
                <span class="social-icon" set:html={link.icon} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      backToTop && (
        <button type="button" class="dcf-totop" data-to-top>
          Subir ↑
        </button>
      )
    }
  </div>
</footer>

<script src="../scripts/footer.ts"></script>

<style>
  @import "../styles/components/footer.css";
</style>
