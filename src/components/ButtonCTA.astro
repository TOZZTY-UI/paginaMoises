---
interface Props {
  href: string;
  name: string;
  modalTarget?: string;
  className?: string;
}

const { href, name, modalTarget, className } = Astro.props as Props;
---
<a
  class:list={["btn-white", className]}
  href={modalTarget ? `#${modalTarget}` : href}
  data-modal-trigger={modalTarget}
  aria-haspopup={modalTarget ? 'dialog' : undefined}
>
  {name}
</a>

<style>
  @import "../styles/components/buttonCTA.css";
</style>
