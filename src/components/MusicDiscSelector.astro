
---
import { repertoire2 as repertoire } from '../data/repertoire';

type Song = {
  song: string;
  artist?: string;
  album?: string;
  image?: string;
  imagen?: string;
  link?: string;
};

const collection: Record<string, Song[]> =
  Array.isArray(repertoire)
    ? { Repertorio: repertoire }
    : repertoire as Record<string, Song[]>;

const colors = [
  '#d94c87',
  '#13b987',
  '#6376d9',
  '#d5a34e',
  '#945ac5',
  '#20b9d6',
];

const genres = Object.entries(collection).map(
  ([name, songs], index) => ({
    name,
    label: name.replaceAll('_', ' '),
    songs,
    color: colors[index % colors.length],
  })
);
---

<section class="music-library" data-music-library>
  <header class="intro">
    <span class="eyebrow">SAXOEVENTOS COLLECTION</span>
    <h2>Explora nuestro repertorio</h2>
    <p>Selecciona un estuche para descubrir sus discos.</p>
  </header>

  <!-- ESTUCHES DE LOS GÉNEROS -->
  <div class="album-grid" data-album-grid>
    {genres.map((genre, index) => (
      <button
        type="button"
        class="album-button"
        data-album={index}
        aria-expanded="false"
        style={`--accent:${genre.color}`}
      >
        <span class="jewel-case">
          <span class="case-spine"></span>

          <span class="case-cover">
            <span class="brand">SAXOEVENTOS</span>

            <span class="cover-disc" aria-hidden="true">
              <span class="cover-hole"></span>
            </span>

            <strong>{genre.label}</strong>
            <small>MUSIC COLLECTION</small>
          </span>

          <span class="case-glass"></span>
        </span>

        <span class="album-details">
          <strong>{genre.label}</strong>
          <small>
            {genre.songs.length} canciones
          </small>
        </span>
      </button>
    ))}
  </div>

  <!-- CONTENIDO DE CADA ESTUCHE -->
  {genres.map((genre, genreIndex) => (
    <div
      class="album-view"
      data-album-view={genreIndex}
      hidden
    >
      <div class="view-header">
        <div>
          <span class="eyebrow">COLECCIÓN MUSICAL</span>

          <h3 tabindex="-1" data-album-title>
            {genre.label}
          </h3>

          <p>{genre.songs.length} canciones disponibles</p>
        </div>

        <button
          type="button"
          class="back-button"
          data-back
        >
          ← Volver a los álbumes
        </button>
      </div>

      <div class="disc-grid">
        {genre.songs.map((song, index) => {
          const cover = song.image || song.imagen;

          return (
            <article class="music-card">
              <div class="disc-area">
                <div
                  class="compact-disc"
                  style={`--disc-color:${colors[(genreIndex + index) % colors.length]}`}
                >
                  {cover && (
                    <img
                      src={cover}
                      alt={`Carátula de ${song.album || song.song}`}
                      width="240"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                  )}

                  <span class="disc-groove"></span>
                  <span class="disc-hole"></span>
                </div>
              </div>

              <div class="song-details">
                <strong>{song.song}</strong>

                {song.artist && (
                  <span>{song.artist}</span>
                )}

                {song.album && (
                  <small>{song.album}</small>
                )}
              </div>

              {song.link && (
                <a
                  class="play-button"
                  href={song.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Escuchar ${song.song}`}
                >
                  ▶ Escuchar canción
                </a>
              )}
            </article>
          );
        })}
      </div>
    </div>
  ))}
</section>

<script src="../scripts/music-disc-selector.ts"></script>

<style>
  @import "../styles/music-disc-selector.css";
</style>
